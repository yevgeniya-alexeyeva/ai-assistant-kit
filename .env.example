# Ключ из Google AI Studio: https://aistudio.google.com/apikey
# Используется только сервером и не должен попадать в клиентский код.
GEMINI_API_KEY=

# Бесплатная модель по умолчанию. Её можно заменить без изменений в коде.
GEMINI_MODEL=gemini-3.5-flash

PORT=8787
CLIENT_ORIGIN=http://localhost:5173
